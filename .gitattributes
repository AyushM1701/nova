# shell scripts must keep Unix line endings to run on macOS
*.sh text eol=lf
*.command text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# left out of the release zips (git archive): every install and update downloads the whole zip
docs/media/** export-ignore
docs/superpowers/** export-ignore
docs/banner.png export-ignore
docs/video/** export-ignore
