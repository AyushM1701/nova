{
  "manifest_version": 3,
  "name": "Nova",
  "description": "Lets the Nova voice assistant on this computer read and use your browser. Talks only to Nova on 127.0.0.1.",
  "version": "1.0.1",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Nova", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "downloads", "sidePanel", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
